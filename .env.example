# Reserved names only. No environment configuration is required for local defaults.
# Automated checks and live E2E run WITHOUT a provider (no tokens spent).
# Manual human-only real-provider smoke (never run by automated agents):
#   AI_PROVIDER=openai
#   OPENAI_MODEL=<explicit supported model ID, e.g. a current Responses-API model>
#   OPENAI_API_KEY=<secret supplied in the environment, never committed>
# If any of AI_PROVIDER/OPENAI_API_KEY/OPENAI_MODEL is absent or AI_PROVIDER is
# unsupported, /api/v1/analyze returns a controlled 503 and the app still starts.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
BACKEND_BASE_URL=
NEXT_PUBLIC_BACKEND_BASE_URL=
