# Reserved names only. No environment configuration is required for local defaults.
# Automated checks and live E2E run WITHOUT a provider (no tokens spent).
# Manual human-only real-provider smoke (never run by automated agents).
# Direct OpenAI:
#   AI_PROVIDER=openai
#   OPENAI_MODEL=<explicit supported model ID>
#   OPENAI_API_KEY=<secret supplied in the environment, never committed>
# FreeLLMAPI auto router:
#   AI_PROVIDER=freellmapi
#   FREELLMAPI_MODEL=auto
#   FREELLMAPI_BASE_URL=http://localhost:3001/v1
#   FREELLMAPI_API_KEY=<secret supplied in the environment, never committed>
# If the selected provider's key/model is absent, or AI_PROVIDER is missing or
# unsupported, /api/v1/analyze returns a controlled 503 and the app still starts.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=
FREELLMAPI_MODEL=
BACKEND_BASE_URL=
NEXT_PUBLIC_BACKEND_BASE_URL=
